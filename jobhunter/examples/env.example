# Скопируйте в workspace/.env и заполните. Файл .env в git не попадает.

# --- Почта для отправки отчёта (SMTP). Для Mail.ru / Яндекса нужен «пароль для внешних приложений».
SMTP_SERVER=smtp.mail.ru
SMTP_PORT=465
EMAIL_SENDER_LOGIN=
EMAIL_SENDER_PASSWORD=
JOBHUNTER_RECEIVER=

# --- Почта, куда приходят письма с hh.ru и Хабр Карьеры (IMAP, только чтение).
# Для Gmail: myaccount.google.com → Безопасность → Пароли приложений (16 символов).
IMAP_SERVER=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# --- LLM (OpenAI-совместимый API): профиль из PDF и, при желании, «ИИ-судья» требований.
# Примеры: OpenRouter https://openrouter.ai/api/v1, DeepSeek https://api.deepseek.com, OpenAI https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
