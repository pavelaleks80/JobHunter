# Скопируйте в workspace/.env и заполните. Файл .env в git не попадает.

# Для почты нужен НЕ обычный пароль, а «пароль приложения». Как получить (Gmail, Mail.ru, Яндекс):
# https://github.com/pavelaleks80/JobHunter/blob/main/docs/app-passwords.md

# --- Почта для отправки отчёта (SMTP). Gmail: smtp.gmail.com, Яндекс: smtp.yandex.ru
SMTP_SERVER=smtp.mail.ru
SMTP_PORT=465
EMAIL_SENDER_LOGIN=
EMAIL_SENDER_PASSWORD=
JOBHUNTER_RECEIVER=

# --- Почта, куда приходят письма с hh.ru и Хабр Карьеры (IMAP, только чтение).
# Gmail: пароль приложения из 16 букв, https://myaccount.google.com/apppasswords (пробелы можно оставить).
IMAP_SERVER=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# --- LLM (OpenAI-совместимый API): профиль из PDF и, при желании, «ИИ-судья» требований.
# Примеры: OpenRouter https://openrouter.ai/api/v1, DeepSeek https://api.deepseek.com, OpenAI https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
